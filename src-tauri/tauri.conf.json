{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "商品图匠",
  "version": "0.1.3",
  "identifier": "com.listingforge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "商品图匠 · ListingForge",
        "width": 1586,
        "height": 992,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data: https:; connect-src ipc: http://ipc.localhost http://localhost:* ws://localhost:* https://api.apimart.ai https://api.deepseek.com https://dashscope.aliyuncs.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "本地 AI 电商图片工作台",
    "longDescription": "商品图匠是一款本地优先的跨平台 AI 电商图片生成、编辑与导出工具。",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
