    "jsdom": "^30.0.1",
    "puppeteer-core": "^25.5.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
