    "@tauri-apps/plugin-sql": "^2.4.0",
    "ag-psd": "^31.0.2",
    "clsx": "^2.1.1",
    "fabric": "^7.4.0",
    "i18next": "^26.3.6",
    "jszip": "^3.10.1",
    "lucide-react": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.11",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
